# Leave values commented to trigger the first-run preference prompt.
# Uncomment and edit these only if you want to preconfigure this machine.
#
# LARK_DOC_CLONER_PREFERRED_IDENTITY=bot
#
# Optional. Bot-created clones transfer ownership to the current CLI user by default.
# Set this only when the current CLI user cannot be detected or you want a specific owner.
# LARK_DOC_CLONER_OWNER_OPEN_ID=ou_xxxxxxxx
